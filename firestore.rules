rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/householdMembers/$(request.auth.uid + '_' + householdId)) == false &&
        existsAfterQuery(householdId);
    }

    function existsAfterQuery(householdId) {
      return exists(/databases/$(database)/documents/householdMembers/{memberId}) &&
        get(/databases/$(database)/documents/householdMembers/{memberId}).data.householdId == householdId &&
        get(/databases/$(database)/documents/householdMembers/{memberId}).data.userId == request.auth.uid;
    }

    function memberDoc(householdId) {
      return get(/databases/$(database)/documents/householdMembers/{memberId})
        where memberId matches '.*';
    }

    function isMember(householdId) {
      return isSignedIn();
    }

    match /households/{householdId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
    }

    match /householdMembers/{memberId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /householdSettings/{householdId} {
      allow read, write: if isSignedIn();
    }

    match /householdInvites/{inviteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    match /monthlyReports/{reportId} {
      allow read, write: if isSignedIn();
    }

    match /fixedDonations/{donationId} {
      allow read, write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    match /userProfiles/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
